# Plex proxy target. Restart Vite or recreate the Docker container after changes.
PLEX_SERVER_URL=http://192.168.178.46:32400
# Optional: comma-separated rail titles, followed by remaining genres alphabetically.
VITE_SECTION_ORDER=Recently Added,Continue Watching,Unwatched Movies
# Never put a Plex token in a VITE_ variable. Enter it in the application.

# Docker Compose: .env is loaded automatically; .env.local needs --env-file.
PLEXPLORE_BIND_IP=127.0.0.1
PLEXPLORE_PORT=8080
# Optional advanced trailer diagnostics. Docker applies this at startup.
PLEXPLORE_DIAGNOSTICS=false
